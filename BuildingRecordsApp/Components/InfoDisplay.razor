@typeparam TItem where TItem : IItemViewEntry
@using BuildingRecordsApp.Models.DisplayViewModels
@using BuildingRecordsApp.Models.ItemViewModels
@using BuildingRecordsApp.Enums
@using Microsoft.AspNetCore.Mvc.ViewFeatures

@inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper Html

@if (Model is not null)
{
    @switch (Model.DisplayLayout)
    {
        case Enums.DisplayLayout.Table:
            {
                var firstEntry = Model.Entries.FirstOrDefault();
                var headers = firstEntry?.GetHeaders(Model.DisplayMode) ?? new List<string> { "Records" };
                <div class="table-responsive filtered-index" data-filtered-index>
                <table class="table table-striped table-bordered align-middle mb-0">
                    <thead>
                        <tr>
                            @foreach (var header in headers)
                            {
                                <th>@(firstEntry?.GetDisplayName(header) ?? header)</th>
                            }
                            @if (Model.ShowActions)
                            {
                                <th class="index-actions-heading"><span class="visually-hidden">Actions</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (firstEntry is not null)
                        {
                            <tr class="table-light column-filter-row">
                                @for (var columnIndex = 0; columnIndex < headers.Count; columnIndex++)
                                {
                                    var label = firstEntry.GetDisplayName(headers[columnIndex]);
                                    <td><input type="search" class="form-control form-control-sm" placeholder="Filter" aria-label="Filter by @label" data-column-filter="@columnIndex" /></td>
                                }
                                @if (Model.ShowActions)
                                {
                                    <td class="index-actions-cell"></td>
                                }
                            </tr>
                        }
                        @foreach (var entry in Model.Entries)
                        {
                            <tr data-record-row="@entry.GetId()">
                                @foreach (var value in entry.GetValues(Model.DisplayMode))
                                {
                                    <td data-filter-value="@(value.Value?.ToString()?.ToLowerInvariant())">@FormatValue(value.Value)</td>
                                }
                                @if (Model.ShowActions)
                                {
                                    <td class="index-actions-cell" data-record-actions="@entry.GetId()">
                                        @{
                                            var compType = typeof(BuildingRecordsApp.Components.IndexRowActions);
                                            <DynamicComponent Type="compType" Parameters="@(new Dictionary<string, object?>
                                            {
                                                ["Id"] = entry.GetId(),
                                                ["BasePath"] = BasePath,
                                                ["DetailsPath"] = DetailsPath
                                            })" />
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        @if (firstEntry is null)
                        {
                            <tr>
                                <td colspan="@(headers.Count + (Model.ShowActions ? 1 : 0))" class="text-center text-muted py-4">No records have been added yet.</td>
                            </tr>
                        }
                        <tr data-no-filter-results hidden>
                            <td colspan="@(headers.Count + (Model.ShowActions ? 1 : 0))" class="text-center text-muted py-4">No records match these filters.</td>
                        </tr>
                    </tbody>
                </table>
                </div>
            }
            break;
        case Enums.DisplayLayout.List:
            {
                foreach (var entry in Model.Entries)
                {
                    var headerText = entry.GetTitleHeader();
                    <div class="mb-4 border rounded p-3">
                        <h4>@headerText</h4>
                        <dl>
                            @foreach (var value in entry.GetValues(Model.DisplayMode))
                            {
                                @if (!entry.IsTitleHeaderFieldName(value.Key))
                                {
                                    <dt>@entry.GetDisplayName(value.Key)</dt>
                                    <dd>@FormatValue(value.Value)</dd>
                                }
                            }
                        </dl>
                    </div>
                    <br />
                }
            }
        break;
    }
}

@code {
    [Parameter] public DisplayViewModel<TItem>? Model { get; set; }
    [Parameter] public string BasePath { get; set; } = string.Empty;
    [Parameter] public string? DetailsPath { get; set; }

    private static object? FormatValue(object? value) => value switch
    {
        bool flag => flag ? "Yes" : "No",
        DateTime date => date.ToString("d MMM yyyy"),
        _ => value
    };
}
