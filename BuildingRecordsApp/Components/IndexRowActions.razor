@using Microsoft.AspNetCore.Mvc.RazorPages

<div class="btn-group" role="group">
    <a class="btn btn-sm btn-primary" href="@($"{BasePath}/Details/{Id}")">Details</a>
    <a class="btn btn-sm btn-secondary" href="@($"{BasePath}/Edit/{Id}")">Edit</a>
    <a class="btn btn-sm btn-danger" href="@($"{BasePath}/Delete/{Id}")">Delete</a>
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string BasePath { get; set; } = string.Empty;
}
