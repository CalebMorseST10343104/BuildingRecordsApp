<div class="btn-group" role="group" aria-label="Actions">
    @if (!string.IsNullOrWhiteSpace(DetailsPath))
    {
        <a class="btn btn-sm btn-outline-primary" href="@($"{DetailsPath}?id={Id}")">Open</a>
    }
    <a class="btn btn-sm btn-primary" href="@($"{BasePath}/Edit?id={Id}")">Edit</a>
    <a class="btn btn-sm btn-danger" href="@($"{BasePath}/Delete?id={Id}")">Delete</a>
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string BasePath { get; set; } = string.Empty;
    [Parameter] public string? DetailsPath { get; set; }
}
