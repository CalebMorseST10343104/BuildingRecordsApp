@page
@model BuildingRecordsApp.Pages.Vehicles.DeleteModel
@{
    ViewData["Title"] = "Delete Vehicle";
}
<h1>Delete Vehicle</h1>
<p>Are you sure you want to delete this vehicle?</p>

<div>
    <div>
        <component type="typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.VehicleItemViewEntry>)" render-mode="Static" param-Model="Model.ViewModel" />
    </div>
    <br />
    <form method="post">
        <input type="hidden" name="id" value="@Model.GetFirstId()" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
