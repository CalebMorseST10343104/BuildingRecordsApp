@page
@model BuildingRecordsApp.Pages.Vehicles.IndexModel
@{
    ViewData["Title"] = "Vehicles";
}

<h1>Vehicle Index</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create New Vehicle</a>
</p>

<div>
    @{
        var BasePath = "BuildingRecordsApp/Pages/Vehicles";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.VehicleItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>