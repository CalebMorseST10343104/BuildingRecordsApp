@model BuildingRecordsApp.Models.FormViewModels.VehicleFormViewModel

<div>
    <label asp-for="VehicleRegistration"></label>
    <input asp-for="VehicleRegistration" />
    <span asp-validation-for="VehicleRegistration" class="text-danger"></span>
</div>

<div>
    <label asp-for="VehicleModel"></label>
    <input asp-for="VehicleModel" />
    <span asp-validation-for="VehicleModel" class="text-danger"></span>
</div>

<div>
    <label asp-for="VehicleMake"></label>
    <input asp-for="VehicleMake" />
    <span asp-validation-for="VehicleMake" class="text-danger"></span>
</div>

<div>
    <label asp-for="VehicleColor"></label>
    <input asp-for="VehicleColor" />
    <span asp-validation-for="VehicleColor" class="text-danger"></span>
</div>

<div>
    <label asp-for="UnitId"></label>
    <select asp-for="UnitId" asp-items="@Model.UnitSelectList">
        <option value="">Select Unit</option>
    </select>
    <span asp-validation-for="UnitId" class="text-danger"></span>
</div>