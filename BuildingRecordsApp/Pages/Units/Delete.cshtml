@page
@model BuildingRecordsApp.Pages.Units.DeleteModel
@{
    ViewData["Title"] = "Delete Unit";
}

<h1>Delete Unit</h1>
<p>Are you sure you want to delete this unit?</p>
<div>
    <h4>Unit</h4>
    <div>
        <component type="typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.UnitItemViewEntry>)" render-mode="Static" param-Model="Model.ViewModel" />
    </div>
    <br />
    <form method="post">
        <input type="hidden" name="id" value="@Model.GetFirstId()" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
