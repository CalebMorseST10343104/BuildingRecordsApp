@page
@model BuildingRecordsApp.Pages.Units.DeleteModel
@{
    ViewData["Title"] = "Delete Unit";
}

<h1>Delete Unit</h1>
<p>Are you sure you want to delete this unit?</p>
<div>
    <h4>Unit</h4>
    <hr/>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DisplayModel.UnitNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DisplayModel.UnitNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DisplayModel.Building!.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DisplayModel.Building!.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DisplayModel.Bedrooms)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DisplayModel.Bedrooms)
        </dd>
        <dt class="col-sm-2">
            Primary Contact - @Html.DisplayNameFor(model => model.DisplayModel.PrimaryContactPerson!.FirstName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DisplayModel.PrimaryContactPerson!.FirstName)
        </dd>
        <dt class="col-sm-2">
            Primary Contact - @Html.DisplayNameFor(model => model.DisplayModel.PrimaryContactPerson!.LastName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DisplayModel.PrimaryContactPerson!.LastName)
        </dd>
        <dt class="col-sm-2">
            Primary Contact - @Html.DisplayNameFor(model => model.DisplayModel.PrimaryContactPerson!.PhoneNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DisplayModel.PrimaryContactPerson!.PhoneNumber)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="DisplayModel.UnitId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
