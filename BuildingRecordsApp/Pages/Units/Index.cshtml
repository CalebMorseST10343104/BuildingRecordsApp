@page
@model BuildingRecordsApp.Pages.Units.IndexModel
@{
    ViewData["Title"] = "Units";
}

<h1>Unit Index</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create New Unit</a>
</p>

<div>
    @{
        var BasePath = "BuildingRecordsApp/Pages/Units";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.UnitItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>