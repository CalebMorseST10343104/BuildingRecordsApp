@page
@model BuildingRecordsApp.Pages.ParkingBays.CreateModel
@{
    ViewData["Title"] = "Create Parking Bay";
}

<h1>Add parking bay</h1>

@* 
ParkingBay has following fields:
int ParkingBayID
int ParkingBayNumber
int UnitID // Foreign key
Unit Unit // Navigation property
 *@

<form method="post" class="crud-form mt-4">
    <input asp-for="ReturnToProperty" type="hidden" />

    <partial name="_Form" for="ViewModel" />

    <button type="submit" class="btn btn-primary">Save new record</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
