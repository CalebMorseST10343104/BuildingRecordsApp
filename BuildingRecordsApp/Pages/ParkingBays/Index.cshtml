@page
@model BuildingRecordsApp.Pages.ParkingBays.IndexModel
@{
    ViewData["Title"] = "Parking Bays";
}

<h1>Parking Bay Index</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create New Parking Bay</a>
</p>

<div>
    @{
        var BasePath = "BuildingRecordsApp/Pages/ParkingBays";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.ParkingBayItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>