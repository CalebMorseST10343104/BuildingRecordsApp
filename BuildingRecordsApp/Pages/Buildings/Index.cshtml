@page
@using BuildingRecordsApp.Pages.Buildings
@model BuildingRecordsApp.Pages.Buildings.IndexModel
@{
    ViewData["Title"] = "Buildings";
}
<h1>Building Index</h1>
<p>
    <a asp-page="./Create" class="btn btn-primary">Create New Building</a>
</p>

<div>
    @{
        var BasePath = "/Buildings";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.BuildingItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel" 
            param-BasePath="BasePath" />
    }
</div>
