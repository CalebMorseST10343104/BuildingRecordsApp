@page
@model BuildingRecordsApp.Pages.Properties.EditModel
@{
    ViewData["Title"] = "Edit Property";
}
<h1>Edit property</h1>
<form method="post" class="mt-4">
    <partial name="_Form" model="Model.ViewModel" />
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-page="./Details" asp-route-id="@Model.ViewModel.PropertyId" class="btn btn-link">Cancel</a>
</form>
<partial name="_ValidationScriptsPartial" />
