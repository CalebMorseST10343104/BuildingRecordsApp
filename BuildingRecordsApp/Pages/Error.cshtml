@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}
<h1>We couldn't complete that change</h1>
<p class="lead">@Model.UserMessage</p>
<p><a asp-page="/Index" class="btn btn-primary">Return to the register</a></p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}
