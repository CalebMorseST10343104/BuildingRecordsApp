@page
@model BuildingRecordsApp.Pages.AgentCompanies.IndexModel
@{
    ViewData["Title"] = "Agent Companies";
}

<h1>Agent Company Index</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create New Agent Company</a>
</p>

<div>
    @{
        var BasePath = "BuildingRecordsApp/Pages/AgentCompanies";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.AgentCompanyItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>