@page
@model BuildingRecordsApp.Pages.AgentCompanies.DeleteModel
@{
    ViewData["Title"] = "Delete Agent Company";
}
<h1>Delete Agent Company</h1>
<p>Are you sure you want to delete this agent company?</p>
<div>
    <div>
        <component type="typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.AgentCompanyItemViewEntry>)" render-mode="Static" param-Model="Model.ViewModel" />
    </div>
    <form method="post">
        <input type="hidden" name="id" value="@Model.GetFirstId()" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
