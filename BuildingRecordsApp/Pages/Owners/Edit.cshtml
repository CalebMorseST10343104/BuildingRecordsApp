@page
@model BuildingRecordsApp.Pages.Owners.EditModel
@{
    ViewData["Title"] = "Edit OwnershipContact";
}

<h1>Edit OwnershipContact</h1>

<form method="post">
    <input type="hidden" name="OwnershipContactId" value="@Model.ViewModel.OwnershipContactId" />
    
    @await Html.PartialAsync("_Form", Model.ViewModel)

    <button type="submit" class="btn btn-primary">Edit</button>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
