@page
@model BuildingRecordsApp.Pages.StoreRooms.IndexModel
@{
    ViewData["Title"] = "Store Rooms";
}

<h1>Store Room Index</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create New Store Room</a>
</p>

<div>
    @{
        var BasePath = "BuildingRecordsApp/Pages/StoreRooms";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.StoreRoomItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>