@model BuildingRecordsApp.Models.FormViewModels.StoreRoomFormViewModel

<div class="mb-3">
    <label asp-for="PropertyId">Property</label>
    <select asp-for="PropertyId" asp-items="Model.PropertySelectList">
        <option value="">Select property</option>
    </select>
</div>
<div>
    <label asp-for="StoreRoomNumber"></label>
    <input asp-for="StoreRoomNumber" />
    <span asp-validation-for="StoreRoomNumber" class="text-danger"></span>
</div>
<div>
    <label asp-for="UnitId"></label>
    <select asp-for="UnitId" asp-items="@Model.UnitSelectList">
        <option value="">Select Unit</option>
    </select>
    <span asp-validation-for="UnitId" class="text-danger"></span>
</div>
