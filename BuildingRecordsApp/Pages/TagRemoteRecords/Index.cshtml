@page
@model BuildingRecordsApp.Pages.TagRemoteRecords.IndexModel
@{
    ViewData["Title"] = "T&R Records";
}

<h1>Tag & Remote Record Index</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create New Tag & Remote Record</a>
</p>

<div>
    @{
        var BasePath = "BuildingRecordsApp/Pages/TagRemoteRecords";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.TagRemoteRecordItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>

