@page
@model BuildingRecordsApp.Pages.TagRemoteRecords.DeleteModel
@{
    ViewData["Title"] = "Delete T&R Record";
    var firstEntry = Model.ViewModel.Entries.FirstOrDefault();
    var TagsOwner = firstEntry?.TagsOwner;
    var TagsOccupant = firstEntry?.TagsOccupant;
    var TagsAgent = firstEntry?.TagsAgent;
    var RemotesOwner = firstEntry?.RemotesOwner;
    var RemotesOccupant = firstEntry?.RemotesOccupant;
    var RemotesAgent = firstEntry?.RemotesAgent;
}
<h1>Delete Tag & Remote Record</h1>
<p>Are you sure you want to delete this tag & remote record?</p>

<div>
    <div>
        <component type="typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.TagRemoteRecordItemViewEntry>)" render-mode="Static" param-Model="Model.ViewModel" />
    </div>
    <br />
    <div style="width: 50%; overflow-x: auto;">
        <table class="table">
            <thead>
                <tr>
                    <th></th>
                    <th>OwnershipContact</th>
                    <th>Occupant</th>
                    <th>Agent</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Tags</td>
                    <td>@TagsOwner</td>
                    <td>@TagsOccupant</td>
                    <td>@TagsAgent</td>
                </tr>
                <tr>
                    <td>Remotes</td>
                    <td>@RemotesOwner</td>
                    <td>@RemotesOccupant</td>
                    <td>@RemotesAgent</td>
                </tr>
            </tbody>
        </table>
    </div>
    <form method="post">
        <input type="hidden" name="id" value="@Model.GetFirstId()" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
