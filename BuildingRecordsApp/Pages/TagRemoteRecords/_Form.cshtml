@model BuildingRecordsApp.Models.FormViewModels.TagRemoteRecordFormViewModel

<div class="form-group">
    <label asp-for="UnitId"></label>
    <select asp-for="UnitId" asp-items="@Model.UnitSelectList" class="form-control"></select>
    <span asp-validation-for="UnitId" class="text-danger"></span>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Holder</th>
            <th>Tags</th>
            <th>Remotes</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>OwnershipContact</td>
            <td>
                <input asp-for="TagsOwner" class="form-control" />
                <span asp-validation-for="TagsOwner" class="text-danger"></span>
            </td>
            <td>
                <input asp-for="RemotesOwner" class="form-control" />
                <span asp-validation-for="RemotesOwner" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <td>Occupant</td>
            <td>
                <input asp-for="TagsOccupant" class="form-control" />
                <span asp-validation-for="TagsOccupant" class="text-danger"></span>
            </td>
            <td>
                <input asp-for="RemotesOccupant" class="form-control" />
                <span asp-validation-for="RemotesOccupant" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <td>Agent</td>
            <td>
                <input asp-for="TagsAgent" class="form-control" />
                <span asp-validation-for="TagsAgent" class="text-danger"></span>
            </td>
            <td>
                <input asp-for="RemotesAgent" class="form-control" />
                <span asp-validation-for="RemotesAgent" class="text-danger"></span>
            </td>
        </tr>
    </tbody>
</table>