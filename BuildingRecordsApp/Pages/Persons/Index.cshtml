@page
@model BuildingRecordsApp.Pages.Persons.IndexModel
@{
    ViewData["Title"] = "Persons";
}

<h1>People</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Add person</a>
</p>

<div>
    @{
        var BasePath = "/Persons";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.PersonItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>
