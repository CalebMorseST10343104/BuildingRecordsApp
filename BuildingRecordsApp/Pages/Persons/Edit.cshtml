@page
@model BuildingRecordsApp.Pages.Persons.EditModel
@{
    ViewData["Title"] = "Edit Person";
}

<h1>Edit Person</h1>

<form method="post" class="crud-form mt-4">
    
    <partial name="_Form" for="ViewModel" />

    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
