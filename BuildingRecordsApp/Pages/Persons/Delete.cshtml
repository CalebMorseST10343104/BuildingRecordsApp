@page
@model BuildingRecordsApp.Pages.Persons.DeleteModel
@{
    ViewData["Title"] = "Delete Person";
}
<h1>Delete Person</h1>
<p>Are you sure you want to delete this person?</p>
<div>
    <div>
        <component type="typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.PersonItemViewEntry>)" render-mode="Static" param-Model="Model.ViewModel" />
    </div>
    <form method="post">
        <input type="hidden" name="id" value="@Model.GetFirstId()" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
