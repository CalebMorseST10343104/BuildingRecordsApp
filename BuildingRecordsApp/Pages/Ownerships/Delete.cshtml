@page
@model BuildingRecordsApp.Pages.Ownerships.DeleteModel
@{
    ViewData["Title"] = "Delete Ownership";
}

<h1>Delete Ownership</h1>
<p>Are you sure you want to delete this ownership?</p>

<div>
    <div>
        <component type="typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.OwnershipItemViewEntry>)" render-mode="Static" param-Model="Model.ViewModel" />
    </div>
    <form method="post">
        <input type="hidden" name="id" value="@Model.GetFirstId()" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
