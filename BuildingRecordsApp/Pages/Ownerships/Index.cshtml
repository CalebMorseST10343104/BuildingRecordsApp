@page
@model BuildingRecordsApp.Pages.Ownerships.IndexModel
@{
    ViewData["Title"] = "Ownerships";
}

<h1>Ownerships</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Add ownership</a>
</p>

<div>
    @{
        var BasePath = "/Ownerships";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.OwnershipItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>
