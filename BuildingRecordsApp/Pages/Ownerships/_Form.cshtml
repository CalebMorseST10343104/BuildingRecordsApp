@model BuildingRecordsApp.Models.FormViewModels.OwnershipFormViewModel

<div>
    <label asp-for="UnitId"></label>
    <select asp-for="UnitId" asp-items="@Model.UnitSelectList"></select>
    <span asp-validation-for="UnitId" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="OwnershipType" class="control-label"></label>
    <select asp-for="OwnershipType" class="form-control">
        <option value="">-- Select Ownership Type --</option>
        <option value="Natural">Natural</option>
        <option value="Juristic">Juristic</option>
    </select>
    <span asp-validation-for="OwnershipType" class="text-danger"></span>
</div>
<div>
    <label asp-for="CompanyTrustId"></label>
    <select asp-for="CompanyTrustId" asp-items="@Model.CompanyTrustSelectList"></select>
    <span asp-validation-for="CompanyTrustId" class="text-danger"></span>
</div>