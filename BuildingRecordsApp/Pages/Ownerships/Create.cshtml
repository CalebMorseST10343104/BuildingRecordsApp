@page
@model BuildingRecordsApp.Pages.Ownerships.CreateModel
@{
    ViewData["Title"] = "Create Ownership";
}
<h1>Add ownership</h1>

@* 
Ownership has following fields:
int OwnershipId
string OwnershipType // e.g., "Natural", "Juristic"
string UnitId // Foreign key for Unit
Unit Unit // Navigation property for Unit
 *@

<form method="post" class="crud-form mt-4">

    <partial name="_Form" for="ViewModel" />

    <button type="submit" class="btn btn-primary">Save new record</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
