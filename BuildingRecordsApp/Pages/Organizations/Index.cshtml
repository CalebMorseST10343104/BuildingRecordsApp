@page
@model BuildingRecordsApp.Pages.Organizations.IndexModel
@{
    ViewData["Title"] = "Companies/Trusts";
}

<h1>Companies and trusts</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Add company or trust</a>
</p>

<div>
    @{
        var BasePath = "/Organizations";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.OrganizationItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>
