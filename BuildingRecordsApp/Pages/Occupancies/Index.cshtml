@page
@model BuildingRecordsApp.Pages.Occupancies.IndexModel
@{
    ViewData["Title"] = "Occupancies";
}

<h1>Occupancy Index</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create New Occupancy</a>
</p>

<div>
    @{
        var BasePath = "/Occupancies";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.OccupancyItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>
