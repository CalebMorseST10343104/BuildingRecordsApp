@model BuildingRecordsApp.Models.FormViewModels.OccupancyFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<input asp-for="OccupancyId" type="hidden" />

<div class="mb-3">
    <label asp-for="OccupationType" class="form-label"></label>
    <select asp-for="OccupationType" class="form-select">
        <option value="">Select occupation type</option>
        @if (!string.IsNullOrWhiteSpace(Model.OccupationType) && !Model.OccupationTypes.Contains(Model.OccupationType))
        {
            <option value="@Model.OccupationType">@Model.OccupationType (existing value)</option>
        }
        @foreach (var type in Model.OccupationTypes)
        {
            <option value="@type">@type</option>
        }
    </select>
    <span asp-validation-for="OccupationType" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="UnitId" class="form-label"></label>
    <select asp-for="UnitId" class="form-select" asp-items="Model.UnitSelectList">
        <option value="">Select unit</option>
    </select>
    <span asp-validation-for="UnitId" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="OccupantId" class="form-label"></label>
    <select asp-for="OccupantId" class="form-select" asp-items="Model.PersonSelectList">
        <option value="">Select occupant</option>
    </select>
    <span asp-validation-for="OccupantId" class="text-danger"></span>
</div>
