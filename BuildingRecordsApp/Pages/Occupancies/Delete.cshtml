@page
@model BuildingRecordsApp.Pages.Occupancies.DeleteModel
@{
    ViewData["Title"] = "Delete Occupancy";
}
<h1>Delete Occupancy</h1>
<p>Are you sure you want to delete this occupancy?</p>

<div>
    <div>
        <partial name="_Info" model="Model.ViewModel" />
    </div>
    <form method="post">
        <input type="hidden" asp-for="GetFirstId()" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
