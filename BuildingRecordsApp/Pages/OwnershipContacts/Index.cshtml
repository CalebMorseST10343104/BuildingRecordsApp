@page
@model BuildingRecordsApp.Pages.OwnershipContacts.IndexModel
@{
    ViewData["Title"] = "Ownership Contacts";
}
<h1>Ownership contacts</h1>
<p>
    <a asp-page="./Create" class="btn btn-primary">Add ownership contact</a>
</p>

<div>
    @{
        var BasePath = "/OwnershipContacts";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.OwnershipContactItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>
