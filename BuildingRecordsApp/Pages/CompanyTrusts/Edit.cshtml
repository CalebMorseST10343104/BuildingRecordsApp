@page
@model BuildingRecordsApp.Pages.CompanyTrusts.EditModel
@{
    ViewData["Title"] = "Edit Company/Trust";
}

<h1>Edit Company/Trust</h1>

@* 
Organization has the following properties:
int OrganizationId
string Name
string Address
string RegistrationNumber
ICollection<Ownership> Ownerships
 *@

<form method="post">
    <input type="hidden" name="OrganizationId" value="@Model.ViewModel.OrganizationId" />
    
    @await Html.PartialAsync("_Form", Model.ViewModel)

    <button type="submit" class="btn btn-primary">Edit</button>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
