@model BuildingRecordsApp.Models.DisplayViewModels.DisplayViewModel<BuildingRecordsApp.Models.ItemViewModels.CompanyTrustItemViewModel>

@switch (Model.DisplayLayout)
{
    case Enums.DisplayLayout.Table:
        {
            var headers = Model.Entries.FirstOrDefault()?.GetHeaders(Model.DisplayMode) ?? new List<string> { "No Data Available" };
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        @foreach (var header in headers)
                        {
                            <th>@header</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            @foreach (var value in entry.GetValues(Model.DisplayMode))
                            {
                                <td>@value.Value</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        break;
    case Enums.DisplayLayout.List:
        {
            foreach (var entry in Model.Entries)
            {
                var headerText = entry.GetTitleHeader;
                <div class="mb-4 border rounded p-3">
                    <h4>@headerText</h4>
                    <dl>
                        @foreach (var value in entry.GetValues(Model.DisplayMode))
                        {
                            @if (entry.IsTitleHeaderFieldName(value.Key))
                            {
                                <dt>@value.Key</dt>
                                <dd>@value.Value</dd>
                            }
                        }
                    </dl>
                </div>
                <br />
            }
        }
    break;
}