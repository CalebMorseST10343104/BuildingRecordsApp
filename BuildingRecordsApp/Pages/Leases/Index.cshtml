@page
@model BuildingRecordsApp.Pages.Leases.IndexModel
@{
    ViewData["Title"] = "Leases";
}

<h1>Lease summaries</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Add lease summary</a>
</p>

<div>
    @{
        var BasePath = "/Leases";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.LeaseItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>
