@page
@model BuildingRecordsApp.Pages.Leases.DeleteModel
@{
    ViewData["Title"] = "Delete Lease";
}
<h1>Delete Lease</h1>
<p>Are you sure you want to delete this lease?</p>

<div>
    <div>
        <partial name="_Info" model="Model.ViewModel" />
    </div>
    <form method="post">
        <input type="hidden" asp-for="GetFirstId()" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>