@page
@model BuildingRecordsApp.Pages.Leases.DeleteModel
@{
    ViewData["Title"] = "Delete Lease";
}
<h1>Delete Lease</h1>
<p>Are you sure you want to delete this lease?</p>

<div>
    <div>
        <h4>Lease</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DisplayModel.LeaseHolderName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.DisplayModel.LeaseHolderName)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DisplayModel.StartDate)
            </dt>
            <dd class="col-sm-10">
                @Model.DisplayModel.StartDate.ToShortDateString()
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DisplayModel.EndDate)
            </dt>
            <dd class="col-sm-10">
                @Model.DisplayModel.EndDate.ToShortDateString()
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DisplayModel.PersonsOccupying)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.DisplayModel.PersonsOccupying)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DisplayModel.SignedRules)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.DisplayModel.SignedRules)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DisplayModel.AllowedPets)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.DisplayModel.AllowedPets)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DisplayModel.EmergencyContactNumber)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.DisplayModel.EmergencyContactNumber)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DisplayModel.Unit!.Building!.Name)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.DisplayModel.Unit!.Building!.Name)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DisplayModel.Unit!.UnitNumber)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.DisplayModel.Unit!.UnitNumber)
            </dd>
        </dl>
    </div>
    <form method="post">
        <input type="hidden" asp-for="DisplayModel.LeaseId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>