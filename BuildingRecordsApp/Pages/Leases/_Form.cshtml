@model BuildingRecordsApp.Models.FormViewModels.LeaseFormViewModel

<div class="form-group">
    <label asp-for="UnitId"></label>
    <select asp-for="UnitId" class="form-control" asp-items="@Model.UnitSelectList">
        <option value="">Select Unit</option>
    </select>
    <span asp-validation-for="UnitId" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="LeaseHolderName"></label>
    <input asp-for="LeaseHolderName" class="form-control" />
    <span asp-validation-for="LeaseHolderName" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="StartDate"></label>
    <input asp-for="StartDate" class="form-control" />
    <span asp-validation-for="StartDate" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="EndDate"></label>
    <input asp-for="EndDate" class="form-control" />
    <span asp-validation-for="EndDate" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="PersonsOccupying"></label>
    <input asp-for="PersonsOccupying" class="form-control" />
    <span asp-validation-for="PersonsOccupying" class="text-danger"></span>
</div>
<div class="form-group form-check">
    <input asp-for="SignedRules" class="form-check-input" type="checkbox" />
    <label asp-for="SignedRules" class="form-check-label"></label>
    <span asp-validation-for="SignedRules" class="text-danger"></span>
</div>
<div class="form-group form-check">
    <input asp-for="AllowedPets" class="form-check-input" type="checkbox" />
    <label asp-for="AllowedPets" class="form-check-label"></label>
    <span asp-validation-for="AllowedPets" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="EmergencyContactNumber"></label>
    <input asp-for="EmergencyContactNumber" class="form-control" />
    <span asp-validation-for="EmergencyContactNumber" class="text-danger"></span>
</div>