@page
@model BuildingRecordsApp.Pages.AccessDeviceCounts.EditModel
@{
    ViewData["Title"] = "Edit T&R Record";
}

<h1>Edit tag and remote counts</h1>

<form method="post" class="crud-form mt-4">

    <partial name="_Form" for="ViewModel" />

    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
