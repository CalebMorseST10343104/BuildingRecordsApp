@page
@model BuildingRecordsApp.Pages.AccessDeviceCounts.CreateModel
@{
    ViewData["Title"] = "Create T&R Record";
}
<h1>Add tag and remote counts</h1>

<form method="post" class="crud-form mt-4">

    <partial name="_Form" for="ViewModel" />

    <button type="submit" class="btn btn-primary">Save new record</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
