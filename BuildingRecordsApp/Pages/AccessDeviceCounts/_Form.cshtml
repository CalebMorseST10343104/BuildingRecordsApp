@model BuildingRecordsApp.Models.FormViewModels.AccessDeviceCountFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<input asp-for="AccessDeviceCountId" type="hidden" />

<div class="mb-3">
    <label asp-for="UnitId" class="form-label">Unit</label>
    <select asp-for="UnitId" asp-items="Model.UnitSelectList" class="form-select">
        <option value="">Select unit</option>
    </select>
    <span asp-validation-for="UnitId" class="text-danger"></span>
</div>

<p class="form-text">Leave a count blank when it is not yet known. Enter zero when it has been confirmed that none are held.</p>
<div class="table-responsive">
<table class="table align-middle">
    <thead>
        <tr>
            <th>Holder</th>
            <th>Tags</th>
            <th>Remotes</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <th scope="row">Ownership contacts</th>
            <td>
                <input asp-for="OwnershipContactTagCount" class="form-control" />
                <span asp-validation-for="OwnershipContactTagCount" class="text-danger"></span>
            </td>
            <td>
                <input asp-for="OwnershipContactRemoteCount" class="form-control" />
                <span asp-validation-for="OwnershipContactRemoteCount" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <th scope="row">Occupants</th>
            <td>
                <input asp-for="OccupantTagCount" class="form-control" />
                <span asp-validation-for="OccupantTagCount" class="text-danger"></span>
            </td>
            <td>
                <input asp-for="OccupantRemoteCount" class="form-control" />
                <span asp-validation-for="OccupantRemoteCount" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <th scope="row">Agent</th>
            <td>
                <input asp-for="AgentTagCount" class="form-control" />
                <span asp-validation-for="AgentTagCount" class="text-danger"></span>
            </td>
            <td>
                <input asp-for="AgentRemoteCount" class="form-control" />
                <span asp-validation-for="AgentRemoteCount" class="text-danger"></span>
            </td>
        </tr>
    </tbody>
</table>
</div>
