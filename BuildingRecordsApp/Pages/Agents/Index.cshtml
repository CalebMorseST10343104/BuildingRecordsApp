@page
@model BuildingRecordsApp.Pages.Agents.IndexModel
@{
    ViewData["Title"] = "Agents";
}
<h1>Agent Index</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create New Agent</a>
</p>

<div>
    @{
        var BasePath = "BuildingRecordsApp/Pages/Agents";
        var CompType = typeof(BuildingRecordsApp.Components.InfoDisplay<BuildingRecordsApp.Models.ItemViewModels.AgentItemViewEntry>);
        <component type="CompType"
            render-mode="Static"
            param-Model="Model.ViewModel"
            param-BasePath="BasePath" />
    }
</div>