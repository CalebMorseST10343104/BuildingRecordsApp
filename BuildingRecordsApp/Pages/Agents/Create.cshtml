@page
@model BuildingRecordsApp.Pages.Agents.CreateModel


@{
    ViewData["Title"] = "Create Agent";
}

<h1>Add letting agent</h1>

<form method="post" class="crud-form mt-4">

    <partial name="_Form" for="ViewModel" />

    <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">Save new record</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
